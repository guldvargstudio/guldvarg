---
import { Image } from "astro:assets";
import type { ProjectSection } from "../lib/projectAssets";

interface Props {
	sections: ProjectSection[];
}

const { sections } = Astro.props;

function aspectRatioStyle(image: { width: number; height: number }) {
	return { "--aspect-ratio": `${image.width} / ${image.height}` };
}

function isSplitLayout(columns: ProjectSection["columns"]) {
	return columns === "2-1" || columns === "1-2";
}

function isWideCell(columns: NonNullable<ProjectSection["columns"]>, index: number) {
	return (columns === "2-1" && index === 0) || (columns === "1-2" && index === 1);
}
---

<div class="project-gallery">
	{
		sections.map((section, sectionIndex) =>
			section.type === "single" ? (
				<figure class="project-gallery__single" style={aspectRatioStyle(section.image)}>
					<Image
						class="project-gallery__image"
						src={section.image}
						alt=""
						width={section.image.width}
						height={section.image.height}
						layout="constrained"
						loading={sectionIndex === 0 ? "eager" : "lazy"}
					/>
				</figure>
			) : isSplitLayout(section.columns) ? (
				<div
					class:list={[
						"project-gallery__split",
						`project-gallery__split--${section.columns}`,
					]}
				>
					{section.images.map((image, index) => {
						const wide = isWideCell(section.columns!, index);
						return (
							<figure
								class:list={[
									"project-gallery__split-cell",
									wide ? "project-gallery__split-cell--cover" : "project-gallery__split-cell--ratio",
								]}
								style={aspectRatioStyle(image)}
							>
								<Image
									class:list={[
										"project-gallery__image",
										wide && "project-gallery__image--cover",
									]}
									src={image}
									alt=""
									width={image.width}
									height={image.height}
									layout="constrained"
									loading="lazy"
								/>
							</figure>
						);
					})}
				</div>
			) : (
				<div
					class="project-gallery__grid"
					style={`--grid-cols: ${section.images.length}`}
				>
					{section.images.map((image) => (
						<figure class="project-gallery__cell" style={aspectRatioStyle(image)}>
							<Image
								class="project-gallery__image"
								src={image}
								alt=""
								width={image.width}
								height={image.height}
								layout="constrained"
								loading="lazy"
							/>
						</figure>
					))}
				</div>
			),
		)
	}
</div>

{sections.length === 0 && <p class="project-gallery__empty">Project images coming soon.</p>}

<style>
	.project-gallery {
		display: flex;
		flex-direction: column;
		gap: 64px;
		width: 100%;
	}

	.project-gallery__single,
	.project-gallery__cell,
	.project-gallery__split-cell--ratio {
		aspect-ratio: var(--aspect-ratio);
		width: 100%;
	}

	.project-gallery__single,
	.project-gallery__cell,
	.project-gallery__split-cell {
		margin: 0;
		overflow: hidden;
		border-radius: 8px;
	}

	.project-gallery__grid {
		display: grid;
		grid-template-columns: repeat(var(--grid-cols, 1), minmax(0, 1fr));
		gap: 16px;
		width: 100%;
	}

	.project-gallery__split {
		display: grid;
		gap: 16px;
		align-items: stretch;
		width: 100%;
	}

	.project-gallery__split--2-1 {
		grid-template-columns: 2fr 1fr;
	}

	.project-gallery__split--1-2 {
		grid-template-columns: 1fr 2fr;
	}

	.project-gallery__split-cell {
		margin: 0;
		overflow: hidden;
		border-radius: 8px;
		min-width: 0;
	}

	.project-gallery__split-cell--cover {
		position: relative;
		min-height: 100%;
		aspect-ratio: auto;
	}

	.project-gallery__image {
		display: block;
		width: 100%;
		height: auto;
	}

	.project-gallery__image--cover {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-gallery__empty {
		margin: 0;
		font-family: var(--font-body);
		font-size: 16px;
		color: var(--color-dark);
		text-align: center;
	}

	@media (max-width: 720px) {
		.project-gallery__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 480px) {
		.project-gallery__grid {
			grid-template-columns: 1fr;
		}

		.project-gallery__split {
			grid-template-columns: 1fr;
		}

		.project-gallery__split-cell--ratio {
			aspect-ratio: var(--aspect-ratio);
		}

		.project-gallery__split-cell--cover {
			aspect-ratio: var(--aspect-ratio);
			min-height: auto;
		}

		.project-gallery__image--cover {
			position: static;
			inset: auto;
			height: auto;
			object-fit: unset;
		}
	}
</style>
