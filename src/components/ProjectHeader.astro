---
import type { ProjectMeta } from "../data/projects";
import UiIcon from "./UiIcon.astro";

interface Props {
	project: ProjectMeta;
}

const { project } = Astro.props;
const hasDetails = Boolean(project.quote || project.intro || project.tags);
const titleWords = project.title.split(/\s+/);
const isSingleWordTitle = titleWords.length === 1;
const titleLongestWord = Math.max(...titleWords.map((word) => word.length), 1);
---

<header class="project-header">
	<div class="project-header__title-block">
		{project.years && <p class="project-header__meta">{project.years}</p>}
		<h1
			class:list={["project-header__title", isSingleWordTitle && "project-header__title--single-word"]}
			style={isSingleWordTitle ? `--title-longest-word: ${titleLongestWord}` : undefined}
		>
			{project.title}
		</h1>
	</div>

	{
		project.intro && hasDetails ? (
			<div class="project-header__expandable">
				<div class="project-header__expandable-inner">
					<div class="project-header__intro-toggle-wrap">
						<button
							type="button"
							class="project-header__intro-toggle"
							aria-expanded="false"
							aria-controls="project-description"
						>
							<span>View description</span>
							<UiIcon name="chevron" class="project-header__intro-toggle-icon" />
						</button>
					</div>

					<div class="project-header__content" id="project-description">
						{project.quote && (
							<blockquote class="project-header__quote">
								<div class="project-header__quote-body">
									<p class="project-header__quote-text text-source-3-italic">{project.quote.text}</p>
									<p class="project-header__quote-by">
										<span class="project-header__quote-label text-source-1-italic">Quote by</span>
										<span>{project.quote.by}</span>
									</p>
								</div>
								<p class="project-header__quote-mark" aria-hidden="true">"</p>
							</blockquote>
						)}

						{project.intro && <p class="project-header__intro">{project.intro}</p>}

						{project.tags && project.tags.length > 0 && (
							<div class="project-header__tags-wrap">
								<p class="project-header__tags-label text-source-1-italic">My areas</p>
								<ul class="project-header__tags">
									{project.tags.map((tag) => (
										<li class="project-header__tag">{tag}</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</div>
			</div>
		) : (
			hasDetails && (
				<div class="project-header__content" id="project-description">
					{project.quote && (
						<blockquote class="project-header__quote">
							<div class="project-header__quote-body">
								<p class="project-header__quote-text text-source-3-italic">{project.quote.text}</p>
								<p class="project-header__quote-by">
									<span class="project-header__quote-label text-source-1-italic">Quote by</span>
									<span>{project.quote.by}</span>
								</p>
							</div>
							<p class="project-header__quote-mark" aria-hidden="true">"</p>
						</blockquote>
					)}

					{project.intro && <p class="project-header__intro">{project.intro}</p>}

					{project.tags && project.tags.length > 0 && (
						<div class="project-header__tags-wrap">
							<p class="project-header__tags-label text-source-1-italic">My areas</p>
							<ul class="project-header__tags">
								{project.tags.map((tag) => (
									<li class="project-header__tag">{tag}</li>
								))}
							</ul>
						</div>
					)}
				</div>
			)
		)
	}
</header>

<script>
	import "../scripts/projectHeader.ts";
</script>
