---
import type { ProjectMeta } from "../data/projects";
import ProjectHeaderContent from "./ProjectHeaderContent.astro";
import UiIcon from "./UiIcon.astro";

interface Props {
	project: ProjectMeta;
}

const { project } = Astro.props;
const hasDetails = Boolean(project.quote || project.intro || project.tags);
const titleWords = project.title.split(/\s+/);
const isSingleWordTitle = titleWords.length === 1;
const titleLongestWord = Math.max(...titleWords.map((word) => word.length), 1);
---

<header class="project-header">
	<div class="project-header__title-block">
		{project.years && <p class="project-header__meta">{project.years}</p>}
		<h1
			class:list={["project-header__title", isSingleWordTitle && "project-header__title--single-word"]}
			style={isSingleWordTitle ? `--title-longest-word: ${titleLongestWord}` : undefined}
		>
			{project.title}
		</h1>
	</div>

	{
		project.intro && hasDetails ? (
			<div class="project-header__expandable">
				<div class="project-header__expandable-inner">
					<div class="project-header__intro-toggle-wrap">
						<button
							type="button"
							class="project-header__intro-toggle"
							aria-expanded="false"
							aria-controls="project-description"
						>
							<span>View description</span>
							<UiIcon name="chevron" class="project-header__intro-toggle-icon" />
						</button>
					</div>

					<ProjectHeaderContent project={project} />
				</div>
			</div>
		) : (
			hasDetails && <ProjectHeaderContent project={project} />
		)
	}
</header>

<script>
	import "../scripts/projectHeader.ts";
</script>
