---
import type { ProjectMeta } from "../data/projects";

interface Props {
	project: ProjectMeta;
}

const { project } = Astro.props;
---

<header class="project-header">
	<div class="project-header__title-block">
		{project.years && <p class="project-header__meta">{project.years}</p>}
		<h1 class="project-header__title">{project.title}</h1>
		{project.role && <p class="project-header__meta">{project.role}</p>}
	</div>

	{
		(project.quote || project.intro || project.tags) && (
			<div class="project-header__content">
				{project.quote && (
					<blockquote class="project-header__quote">
						<p class="project-header__quote-mark" aria-hidden="true">"</p>
						<div class="project-header__quote-body">
							<p class="project-header__quote-text">{project.quote.text}</p>
							<p class="project-header__quote-by">
								<span class="project-header__quote-label">Quote by</span>
								<span>{project.quote.by}</span>
							</p>
						</div>
					</blockquote>
				)}

				{project.intro && <p class="project-header__intro">{project.intro}</p>}

				{project.tags && project.tags.length > 0 && (
					<div class="project-header__tags-wrap">
						<p class="project-header__tags-label">My areas</p>
						<ul class="project-header__tags">
							{project.tags.map((tag) => (
								<li class="project-header__tag">{tag}</li>
							))}
						</ul>
					</div>
				)}
			</div>
		)
	}
</header>

<style>
	.project-header {
		display: flex;
		flex-direction: column;
		gap: 32px;
		width: 100%;
	}

	.project-header__title-block {
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-items: center;
		text-align: center;
	}

	.project-header__meta {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--font-size-caps-lg);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--letter-spacing-caps-lg);
		text-transform: uppercase;
		color: var(--color-rust-1);
	}

	.project-header__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(48px, 10vw, 96px);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: clamp(4.8px, 1vw, 9.6px);
		text-transform: uppercase;
		color: var(--color-dark);
	}

	.project-header__content {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
		align-items: start;
	}

	.project-header__quote {
		display: flex;
		gap: 16px;
		align-items: flex-start;
		margin: 0;
		min-width: 0;
	}

	.project-header__quote-mark {
		margin: 0;
		font-family: var(--font-display);
		font-size: 32px;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 3.2px;
		text-transform: uppercase;
		color: var(--color-rust-1);
	}

	.project-header__quote-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.project-header__quote-text {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--font-size-source-2);
		font-style: italic;
		font-weight: 400;
		line-height: normal;
		color: var(--color-rust-1);
		white-space: pre-line;
	}

	.project-header__quote-by {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: baseline;
		margin: 0;
	}

	.project-header__quote-label {
		font-family: var(--font-body);
		font-size: var(--font-size-source-1);
		font-style: italic;
		font-weight: 400;
		line-height: normal;
		color: var(--color-rust-2);
	}

	.project-header__quote-by span:last-child {
		font-family: var(--font-display);
		font-size: var(--font-size-caps-sm);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--letter-spacing-caps-sm);
		text-transform: uppercase;
		color: var(--color-rust-1);
	}

	.project-header__intro {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--font-size-source-3);
		font-weight: 400;
		line-height: normal;
		color: var(--color-dark);
		white-space: pre-line;
	}

	.project-header__tags-wrap {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.project-header__tags-label {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--font-size-source-1);
		font-style: italic;
		font-weight: 400;
		line-height: normal;
		color: var(--color-rust-2);
	}

	.project-header__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-header__tag {
		padding: 16px;
		border: 2px solid var(--color-rust-1-10);
		border-radius: 100px;
		font-family: var(--font-display);
		font-size: var(--font-size-caps-sm);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--letter-spacing-caps-sm);
		text-transform: uppercase;
		color: var(--color-rust-1);
		white-space: nowrap;
	}

	@media (max-width: 1040px) {
		.project-header__content {
			grid-template-columns: 1fr;
		}

		.project-header__intro {
			order: 1;
		}

		.project-header__quote {
			order: 2;
		}

		.project-header__tags-wrap {
			order: 3;
		}
	}
</style>
