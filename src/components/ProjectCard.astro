---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	href: string;
	thumbnail: ImageMetadata;
	eagerLoad?: boolean;
}

const { title, href, thumbnail, eagerLoad = false } = Astro.props;
---

<a class="project-card" href={href}>
	<p class="project-card__title">{title}</p>
	<div class="project-card__image-wrap">
		<Image
			class="project-card__image"
			src={thumbnail}
			alt=""
			width={316}
			height={316}
			layout="constrained"
			loading={eagerLoad ? "eager" : "lazy"}
		/>
	</div>
</a>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
		width: 100%;
	}

	.project-card__title {
		margin: 0;
		overflow: hidden;
		width: 100%;
		font-family: var(--font-display);
		font-size: var(--font-size-caps-md);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--letter-spacing-caps-md);
		text-transform: uppercase;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.project-card__image-wrap {
		overflow: hidden;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 8px;
	}

	.project-card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
