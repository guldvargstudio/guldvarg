---
import { projects } from "../data/projects";
import StepNavChevron from "./StepNavChevron.astro";

interface Props {
	active?: "home" | "about" | "project";
	prevHref?: string;
	nextHref?: string;
	dotCount?: number;
	activeDotIndex?: number;
	variant?: "default" | "dark";
}

const {
	active = "home",
	prevHref = "/",
	nextHref = "/about",
	dotCount = projects.length,
	activeDotIndex,
	variant = "default",
} = Astro.props;
---

<nav
	class:list={["step-nav", { "step-nav--dark": variant === "dark" }]}
	transition:persist
	transition:animate="none"
	aria-label="Site navigation"
>
	<div class="step-nav__inner" style={`--step-nav-dot-count: ${dotCount}`}>
		<a class="step-nav__btn" href={prevHref} aria-label="Previous" data-nav-direction="prev">
			<StepNavChevron />
		</a>

		<div class="step-nav__center">
			<a
				class:list={["step-nav__label", { "step-nav__label--active": active === "home" }]}
				href="/"
			>
				Home
			</a>

			<div class="step-nav__dots" data-dot-count={dotCount}>
				<a
					class:list={[
						"step-nav__dot",
						"step-nav__dot--endpoint",
						"step-nav__dot--home",
						{ "step-nav__dot--active": active === "home" },
					]}
					href="/"
					data-nav-position="0"
					data-dot-index=""
					aria-label="Home"
					aria-current={active === "home" ? "page" : undefined}
				/>
				{projects.map((project, index) => (
					<a
						class:list={[
							"step-nav__dot",
							{ "step-nav__dot--active": activeDotIndex === index },
						]}
						href={`/projects/${project.slug}`}
						data-nav-position={index + 1}
						data-dot-index={index}
						aria-label={project.title}
						aria-current={activeDotIndex === index ? "page" : undefined}
					/>
				))}
				<a
					class:list={[
						"step-nav__dot",
						"step-nav__dot--endpoint",
						"step-nav__dot--about",
						{ "step-nav__dot--active": active === "about" },
					]}
					href="/about"
					data-nav-position={dotCount + 1}
					data-dot-index=""
					aria-label="About"
					aria-current={active === "about" ? "page" : undefined}
				/>
			</div>

			<a
				class:list={["step-nav__label", { "step-nav__label--active": active === "about" }]}
				href="/about"
			>
				About
			</a>
		</div>

		<a
			class="step-nav__btn step-nav__btn--next"
			href={nextHref}
			aria-label="Next"
			data-nav-direction="next"
		>
			<StepNavChevron />
		</a>
	</div>
</nav>
