---
import { projects } from "../data/projects";

interface Props {
	active?: "home" | "about" | "project";
	prevHref?: string;
	nextHref?: string;
	dotCount?: number;
	activeDotIndex?: number;
}

const {
	active = "home",
	prevHref = "/",
	nextHref = "/about",
	dotCount = projects.length,
	activeDotIndex,
} = Astro.props;
---

<nav
	class:list={["step-nav", { "step-nav--home-hidden": active === "home" }]}
	transition:persist
	transition:animate="none"
	aria-label="Site navigation"
	inert={active === "home" ? true : undefined}
>
	<div class="step-nav__inner" style={`--step-nav-dot-count: ${dotCount}`}>
		<a class="step-nav__btn" href={prevHref} aria-label="Previous" data-nav-direction="prev">
			<svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
				<path
					d="M28 0C32.4183 0 36 3.58172 36 8V28C36 32.4183 32.4183 36 28 36H8C3.58172 36 3.22139e-08 32.4183 0 28V8C0 3.58172 3.58172 3.22128e-08 8 0H28ZM20.6875 11.3125C20.3125 10.9062 19.6562 10.9062 19.2812 11.3125L13.2812 17.3125C12.875 17.6875 12.875 18.3438 13.2812 18.7188L19.2812 24.7188C19.6562 25.125 20.3125 25.125 20.6875 24.7188C21.0938 24.3438 21.0938 23.6875 20.6875 23.3125L15.4062 18L20.6875 12.7188C21.0938 12.3438 21.0938 11.6875 20.6875 11.3125Z"
					fill="currentColor"></path>
			</svg>
		</a>

		<div class="step-nav__center">
			<a
				class:list={["step-nav__label", { "step-nav__label--active": active === "home" }]}
				href="/"
			>
				Home
			</a>

			<div class="step-nav__dots" data-dot-count={dotCount}>
				<a
					class:list={[
						"step-nav__dot",
						"step-nav__dot--endpoint",
						"step-nav__dot--home",
						{ "step-nav__dot--active": active === "home" },
					]}
					href="/"
					data-nav-position="0"
					data-dot-index=""
					aria-label="Home"
					aria-current={active === "home" ? "page" : undefined}
				/>
				{projects.map((project, index) => (
					<a
						class:list={[
							"step-nav__dot",
							{ "step-nav__dot--active": activeDotIndex === index },
						]}
						href={`/projects/${project.slug}`}
						data-nav-position={index + 1}
						data-dot-index={index}
						aria-label={project.title}
						aria-current={activeDotIndex === index ? "page" : undefined}
					/>
				))}
				<a
					class:list={[
						"step-nav__dot",
						"step-nav__dot--endpoint",
						"step-nav__dot--about",
						{ "step-nav__dot--active": active === "about" },
					]}
					href="/about"
					data-nav-position={dotCount + 1}
					data-dot-index=""
					aria-label="About"
					aria-current={active === "about" ? "page" : undefined}
				/>
			</div>

			<a
				class:list={["step-nav__label", { "step-nav__label--active": active === "about" }]}
				href="/about"
			>
				About
			</a>
		</div>

		<a
			class="step-nav__btn step-nav__btn--next"
			href={nextHref}
			aria-label="Next"
			data-nav-direction="next"
		>
			<svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
				<path
					d="M28 0C32.4183 0 36 3.58172 36 8V28C36 32.4183 32.4183 36 28 36H8C3.58172 36 3.22139e-08 32.4183 0 28V8C0 3.58172 3.58172 3.22128e-08 8 0H28ZM20.6875 11.3125C20.3125 10.9062 19.6562 10.9062 19.2812 11.3125L13.2812 17.3125C12.875 17.6875 12.875 18.3438 13.2812 18.7188L19.2812 24.7188C19.6562 25.125 20.3125 25.125 20.6875 24.7188C21.0938 24.3438 21.0938 23.6875 20.6875 23.3125L15.4062 18L20.6875 12.7188C21.0938 12.3438 21.0938 11.6875 20.6875 11.3125Z"
					fill="currentColor"></path>
			</svg>
		</a>
	</div>
</nav>
