---
import { Image } from "astro:assets";
import photo from "../assets/ui/photo-guldvarg.jpg";
import ContactEmailLink from "./ContactEmailLink.astro";
import UiIcon from "./UiIcon.astro";
import { backgroundText, contactLinks, education, skillsText } from "../data/about";
---

<div class="about-content">
	<div class="about-contact-row">
		<section class="about-contact-info" aria-labelledby="about-contact-heading">
			<h2 class="about-heading" id="about-contact-heading">Contact</h2>

			<ul class="about-contact">
				<li>
					<ContactEmailLink class="about-contact__link">
						<UiIcon name="email" class="about-contact__icon" />
					</ContactEmailLink>
				</li>
				{
					contactLinks.map((link) => (
						<li>
							<a
								class="about-contact__link"
								href={link.href}
								target={link.icon === "phone" ? undefined : "_blank"}
								rel={link.icon === "phone" ? undefined : "noopener noreferrer"}
							>
								<UiIcon name={link.icon} class="about-contact__icon" />
								<span>{link.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<div class="about-photo">
			<Image
				class="about-photo__image"
				src={photo}
				alt="Kristofer Guldvarg"
				width={790}
				height={592}
				layout="constrained"
				loading="eager"
			/>
		</div>
	</div>

	<section class="about-section" aria-labelledby="about-me-heading">
		<h2 class="about-heading" id="about-me-heading">About me</h2>

		<div class="about-block">
			<h3 class="about-label">Skills</h3>
			<div class="about-body">
				{skillsText.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>

		<div class="about-block">
			<h3 class="about-label">Background &amp; family</h3>
			<p class="about-body">{backgroundText}</p>
		</div>
	</section>

	<section class="about-section" aria-labelledby="about-education-heading">
		<h2 class="about-heading" id="about-education-heading">Relevant Education</h2>

		<ul class="about-education">
			{
				education.map((entry) => (
					<li class="about-education__item">
						<p class="about-label">{entry.years}</p>
						<p class="about-education__title">{entry.title}</p>
						<p class="about-education__description">{entry.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</div>
