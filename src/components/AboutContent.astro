---
import { Image } from "astro:assets";
import photo from "../assets/ui/photo-guldvarg.jpg";
import UiIcon from "./UiIcon.astro";
import {
	backgroundText,
	contactLinks,
	education,
	skillsText,
	type ContactLink,
} from "../data/about";

const iconNames: Record<ContactLink["icon"], "email" | "phone" | "bluesky" | "threads"> = {
	email: "email",
	phone: "phone",
	bluesky: "bluesky",
	threads: "threads",
};
---

<div class="about-content">
	<div class="about-contact-row">
		<section class="about-contact-info" aria-labelledby="about-contact-heading">
			<h2 class="about-heading" id="about-contact-heading">Contact</h2>

			<ul class="about-contact">
				{
					contactLinks.map((link) => (
						<li>
							<a
								class="about-contact__link"
								href={link.href}
								target={link.icon === "email" || link.icon === "phone" ? undefined : "_blank"}
								rel={link.icon === "email" || link.icon === "phone" ? undefined : "noopener noreferrer"}
							>
								<UiIcon name={iconNames[link.icon]} class="about-contact__icon" />
								<span>{link.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<div class="about-photo">
			<Image
				class="about-photo__image"
				src={photo}
				alt="Kristofer Guldvarg"
				width={790}
				height={592}
				layout="constrained"
				loading="eager"
			/>
		</div>
	</div>

	<section class="about-section" aria-labelledby="about-me-heading">
		<h2 class="about-heading" id="about-me-heading">About me</h2>

		<div class="about-block">
			<h3 class="about-label">Skills</h3>
			<div class="about-body">
				{skillsText.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>

		<div class="about-block">
			<h3 class="about-label">Background &amp; family</h3>
			<p class="about-body">{backgroundText}</p>
		</div>
	</section>

	<section class="about-section" aria-labelledby="about-education-heading">
		<h2 class="about-heading" id="about-education-heading">Relevant Education</h2>

		<ul class="about-education">
			{
				education.map((entry) => (
					<li class="about-education__item">
						<p class="about-label">{entry.years}</p>
						<p class="about-education__title">{entry.title}</p>
						<p class="about-education__description">{entry.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</div>

<style>
	.about-content {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 64px;
		align-items: start;
		width: 100%;
	}

	.about-contact-row {
		display: flex;
		flex-direction: column;
		gap: 32px;
		min-width: 0;
	}

	.about-contact-info,
	.about-section {
		display: flex;
		flex-direction: column;
		gap: 32px;
		min-width: 0;
	}

	.about-heading {
		margin: 0;
		font-family: var(--font-display);
		font-size: 24px;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 2.4px;
		text-transform: uppercase;
		color: var(--color-rust-1);
	}

	.about-label {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--font-size-caps-sm);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--letter-spacing-caps-sm);
		text-transform: uppercase;
		color: var(--color-rust-1);
	}

	.about-body {
		margin: 0;
		font-family: var(--font-body);
		font-size: 16px;
		font-weight: 400;
		line-height: normal;
		color: var(--color-dark);
	}

	.about-body p {
		margin: 0;
	}

	.about-body p + p {
		margin-top: 1em;
	}

	.about-block {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.about-contact {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.about-contact__link {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-display);
		font-size: var(--font-size-caps-sm);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--letter-spacing-caps-sm);
		text-transform: uppercase;
		color: var(--color-rust-1);
		transition: var(--transition-interactive);
	}

	.about-contact__link:hover,
	.about-contact__link:focus-visible {
		color: var(--color-hover);
	}

	.about-contact__icon {
		flex-shrink: 0;
	}

	.about-photo {
		overflow: hidden;
		width: 100%;
		height: 296px;
		border-radius: 8px;
	}

	.about-photo__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-education {
		display: flex;
		flex-direction: column;
		gap: 32px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.about-education__item {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.about-education__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 24px;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 2.4px;
		text-transform: uppercase;
		color: var(--color-dark);
	}

	.about-education__description {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--font-size-source-1);
		font-style: italic;
		font-weight: 400;
		line-height: normal;
		color: var(--color-rust-2);
	}

	@media (max-width: 1040px) {
		.about-content {
			grid-template-columns: 1fr;
			gap: 64px;
		}

		.about-contact-row {
			flex-direction: row;
			gap: 64px;
			align-items: flex-start;
		}

		.about-contact-info {
			flex-shrink: 0;
		}

		.about-contact {
			gap: 24px;
		}

		.about-photo {
			flex: 1 1 0;
			width: auto;
			min-width: 0;
			height: 296px;
		}
	}

	@media (max-width: 560px) {
		.about-contact-row {
			flex-direction: column;
			gap: 32px;
		}

		.about-photo {
			flex: none;
			width: 100%;
		}
	}

	@media (max-width: 768px) {
		.about-heading,
		.about-education__title {
			font-size: 20px;
			letter-spacing: 2px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-contact__link {
			transition: none;
		}
	}
</style>
