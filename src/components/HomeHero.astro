---
import logo from "../assets/ui/logo-guldvarg-on-dark.svg";
import ContactEmailLink from "./ContactEmailLink.astro";
import MainSeparator from "./MainSeparator.astro";
import { contactLinks } from "../data/about";

interface Props {
	nextHref: string;
}

const { nextHref } = Astro.props;

const phone = contactLinks.find((link) => link.icon === "phone");
---

<div class="home-landing">
	<section class="home-hero" aria-label="Guldvarg Studio">
		<a
			class="home-hero__logo-link"
			href={nextHref}
			data-nav-direction="next"
			aria-label="Next"
		>
			<img
				class="home-hero__logo"
				src={logo.src}
				alt="Guldvarg Studio — To save mankind"
				width={248}
				height={282}
				loading="eager"
				fetchpriority="high"
			/>
		</a>
	</section>

	<footer class="home-footer">
		<div class="home-footer__group">
			<MainSeparator />
			<div class="home-contact">
				<ContactEmailLink class="home-contact__link">
					<span data-contact-email-label></span>
				</ContactEmailLink>
				{
					phone && (
						<a class="home-contact__link" href={phone.href}>
							{phone.label}
						</a>
					)
				}
				<span class="home-contact__link home-contact__link--muted">© Guldvarg Studio AB</span>
			</div>
		</div>
	</footer>
</div>
