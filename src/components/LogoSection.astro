---
import logo from "../assets/ui/logo-guldvarg.svg";
---

<section class="logo-section" aria-label="Guldvarg Studio">
	<img
		class="logo-section__logo"
		src={logo.src}
		alt="Guldvarg Studio — To save mankind"
		width="256"
		height="290"
		loading="eager"
		fetchpriority="high"
	/>
</section>

<style>
	.logo-section {
		display: flex;
		justify-content: center;
		padding: 32px 0;
	}

	.logo-section__logo {
		width: 256px;
		height: auto;
	}

	@media (max-width: 768px) {
		.logo-section__logo {
			width: min(256px, 70vw);
		}
	}
</style>
