---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import { getSiteNavigation } from "../data/projectNavigation";
import { homePageBackground } from "../data/projectBackground";
import { siteName } from "../config/site";

import homeStyles from "../styles/pages/home.css?url";

const navigation = getSiteNavigation("home");
---

<link rel="stylesheet" href={homeStyles} />

<BaseLayout
	seo={{ title: siteName, canonicalPath: "/" }}
	navigation={navigation}
	background={homePageBackground}
	theme="dark"
>
	<div class="home">
		<HomeHero />
	</div>
</BaseLayout>
