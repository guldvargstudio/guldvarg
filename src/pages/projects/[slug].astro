---
import MainSeparator from "../../components/MainSeparator.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import ProjectHeader from "../../components/ProjectHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectBySlug, getSiteNavigation, projects } from "../../data/projects";
import { getProjectShareDescription } from "../../lib/socialMeta";
import { parseProjectImages } from "../../lib/projectAssets";

import projectStyles from "../../styles/pages/project.css?url";

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
	}));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
	throw new Error(`Unknown project slug: ${slug}`);
}

const navigation = getSiteNavigation({ slug: project.slug });
const sections = parseProjectImages(
	project.slug,
	project.sectionOrder,
	project.sectionColumns,
	project.sectionGroups,
);
---

<link rel="stylesheet" href={projectStyles} />

<BaseLayout
	title={`${project.title} — Guldvarg Studio`}
	description={getProjectShareDescription(project)}
	image={project.thumbnail}
	imageAlt={`${project.title} project thumbnail`}
	canonicalPath={`/projects/${project.slug}/`}
	background={project.background}
	{...navigation}
>
	<div class="project">
		<ProjectHeader project={project} />
		<ProjectGallery sections={sections} />
		<MainSeparator />
	</div>
</BaseLayout>
