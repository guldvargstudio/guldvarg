---
import AboutContent from "../components/AboutContent.astro";
import MainSeparator from "../components/MainSeparator.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteNavigation } from "../data/projects";
import { truncateDescription } from "../lib/socialMeta";
import { skillsText } from "../data/about";

import aboutStyles from "../styles/pages/about.css?url";

const navigation = getSiteNavigation("about");
const aboutDescription = truncateDescription(skillsText[0]);
---

<link rel="stylesheet" href={aboutStyles} />

<BaseLayout
	title="About — Guldvarg Studio"
	description={aboutDescription}
	canonicalPath="/about/"
	{...navigation}
>
	<div class="about">
		<AboutContent />
		<MainSeparator />
	</div>
</BaseLayout>
