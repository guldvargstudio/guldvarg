---
import { ClientRouter, fade } from "astro:transitions";
import type { ImageMetadata } from "astro";
import StepNav from "../components/StepNav.astro";
import stepNavStyles from "../components/StepNav.css?url";
import globalStyles from "../styles/global.css?url";
import homeFieldStyles from "../styles/homeField.css?url";
import {
	contentSlideInEasingCss,
	contentTransitionDurationCss,
	contentTransitionEasingCss,
	pageBgEasingCss,
	pageBgTransitionCss,
} from "../config/motion";
import type { SiteNavigation } from "../data/projectNavigation";
import { defaultPageBackground, getPageBgEnd } from "../data/projectBackground";
import { clarityProjectId, googleAnalyticsId } from "../config/site";
import {
	defaultOgImage,
	defaultSiteDescription,
	siteName,
	toAbsoluteUrl,
	toImageUrl,
} from "../lib/socialMeta";
import type { SiteSeo } from "../lib/siteSeo";

interface Props {
	seo?: SiteSeo;
	navigation: SiteNavigation;
	background?: string;
	theme?: "default" | "dark";
}

const { seo = {}, navigation, background, theme = "default" } = Astro.props;

const {
	title = siteName,
	description = defaultSiteDescription,
	image = defaultOgImage,
	imageAlt = siteName,
	canonicalPath,
	type = "website",
} = seo;

const pageBackground = background ?? defaultPageBackground;
const pageBgEnd = getPageBgEnd(pageBackground);
const canonicalURL = toAbsoluteUrl(canonicalPath ?? Astro.url.pathname, Astro.site!);
const shareImageUrl =
	typeof image === "string" ? toAbsoluteUrl(image, Astro.site!) : toImageUrl(image, Astro.site!);
const shareImageDimensions = typeof image === "string" ? null : image;
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		{
			shareImageDimensions?.width && shareImageDimensions?.height && (
				<>
					<meta property="og:image:width" content={String(shareImageDimensions.width)} />
					<meta property="og:image:height" content={String(shareImageDimensions.height)} />
				</>
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<link rel="stylesheet" href={globalStyles} />
		<link rel="stylesheet" href={stepNavStyles} />
		<link rel="stylesheet" href={homeFieldStyles} />
		<style is:global>
			:root {
				--page-bg-transition-duration: {pageBgTransitionCss};
				--page-bg-transition-easing: {pageBgEasingCss};
				--content-transition-duration: {contentTransitionDurationCss};
				--content-transition-easing: {contentTransitionEasingCss};
				--content-slide-in-easing: {contentSlideInEasingCss};
			}
		</style>
		<ClientRouter fallback="swap" />
		{
			import.meta.env.PROD && (
				<>
					<script
						is:inline
						async
						src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
					/>
					<script
						is:inline
						set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${googleAnalyticsId}');`}
					/>
					<script
						is:inline
						set:html={`(function(c,l,a,r,i,t,y){
c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "${clarityProjectId}");`}
					/>
				</>
			)
		}
		<script>
			import "../scripts/stepNav.ts";
			import "../scripts/siteHeader.ts";
			import "../scripts/transitions.ts";
			import "../scripts/homeGlow.ts";
			import "../scripts/contactEmail.ts";
			import "../scripts/swipeNav.ts";
			import "../scripts/gtag.ts";
		</script>
	</head>
	<body data-page-bg-end={pageBgEnd}>
		<div
			id="step-nav-state"
			hidden
			aria-hidden="true"
			data-step-nav-active={navigation.active}
			data-step-nav-dot={navigation.activeDotIndex ?? ""}
			data-step-nav-prev={navigation.prevHref}
			data-step-nav-next={navigation.nextHref}
			data-step-nav-variant={theme}
		></div>
		<div
			id="page-bg-fill"
			transition:persist="page-bg-fill"
			transition:animate="none"
			aria-hidden="true"
		></div>
		<div
			id="page-bg"
			transition:persist="page-bg"
			transition:animate="none"
			aria-hidden="true"
		></div>
		<div
			id="home-field-shell"
			transition:persist="home-field"
			transition:name="home-field"
			transition:animate="none"
			aria-hidden="true"
		>
			<canvas id="home-field"></canvas>
		</div>
		<div id="site-header-stack" class="site-header-stack">
			<div id="site-header-backdrop" class="site-header-backdrop" aria-hidden="true"></div>
			<header class="site-header">
				<StepNav
					active={navigation.active}
					prevHref={navigation.prevHref}
					nextHref={navigation.nextHref}
					activeDotIndex={navigation.activeDotIndex}
					dotCount={navigation.dotCount}
					variant={theme === "dark" ? "dark" : "default"}
				/>
			</header>
		</div>
		<div id="site-scroll" class="site-scroll">
			<div class="site-header-spacer" aria-hidden="true"></div>
			<div class="page">
				<main
					transition:name="main"
					transition:animate={fade({ duration: contentTransitionDurationCss })}
				>
					<slot />
				</main>
			</div>
		</div>
	</body>
</html>
