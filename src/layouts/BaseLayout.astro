---
import { ClientRouter, fade } from "astro:transitions";
import type { ImageMetadata } from "astro";
import StepNav from "../components/StepNav.astro";
import stepNavStyles from "../components/StepNav.css?url";
import globalStyles from "../styles/global.css?url";
import {
	contentTransitionDurationCss,
	contentTransitionEasingCss,
	pageBgEasingCss,
	pageBgTransitionCss,
} from "../config/motion";
import { defaultPageBackground, getPageBgEnd } from "../data/projects";
import {
	defaultOgImage,
	defaultSiteDescription,
	siteName,
	toAbsoluteUrl,
	toImageUrl,
} from "../lib/socialMeta";

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	imageAlt?: string;
	canonicalPath?: string;
	type?: "website" | "article";
	active?: "home" | "about" | "project";
	prevHref?: string;
	nextHref?: string;
	background?: string;
	activeDotIndex?: number;
	dotCount?: number;
}

const {
	title = siteName,
	description = defaultSiteDescription,
	image = defaultOgImage,
	imageAlt = siteName,
	canonicalPath,
	type = "website",
	active = "home",
	prevHref,
	nextHref,
	background,
	activeDotIndex,
	dotCount,
} = Astro.props;

const pageBackground = background ?? defaultPageBackground;
const pageBgEnd = getPageBgEnd(pageBackground);
const canonicalURL = toAbsoluteUrl(canonicalPath ?? Astro.url.pathname, Astro.site!);
const shareImageUrl =
	typeof image === "string" ? toAbsoluteUrl(image, Astro.site!) : toImageUrl(image, Astro.site!);
const shareImageDimensions = typeof image === "string" ? null : image;
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		{
			shareImageDimensions?.width && shareImageDimensions?.height && (
				<>
					<meta property="og:image:width" content={String(shareImageDimensions.width)} />
					<meta property="og:image:height" content={String(shareImageDimensions.height)} />
				</>
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<link rel="stylesheet" href={globalStyles} />
		<link rel="stylesheet" href={stepNavStyles} />
		<style is:global>
			:root {
				--page-bg-transition-duration: {pageBgTransitionCss};
				--page-bg-transition-easing: {pageBgEasingCss};
				--content-transition-duration: {contentTransitionDurationCss};
				--content-transition-easing: {contentTransitionEasingCss};
			}
		</style>
		<ClientRouter fallback="swap" />
		<script>
			import "../scripts/stepNav.ts";
			import "../scripts/transitions.ts";
		</script>
	</head>
	<body data-page-bg-end={pageBgEnd}>
		<div
			id="step-nav-state"
			hidden
			aria-hidden="true"
			data-step-nav-active={active}
			data-step-nav-dot={activeDotIndex ?? ""}
			data-step-nav-prev={prevHref}
			data-step-nav-next={nextHref}
		></div>
		<div
			id="page-bg-fill"
			transition:persist="page-bg-fill"
			transition:animate="none"
			aria-hidden="true"
		></div>
		<div
			id="page-bg"
			transition:persist="page-bg"
			transition:animate="none"
			aria-hidden="true"
		></div>
		<header class="site-header">
			<StepNav
				active={active}
				prevHref={prevHref}
				nextHref={nextHref}
				activeDotIndex={activeDotIndex}
				dotCount={dotCount}
			/>
		</header>
		<div class="page">
			<main
				transition:name="main"
				transition:animate={fade({ duration: contentTransitionDurationCss })}
			>
				<slot />
			</main>
		</div>
	</body>
</html>
